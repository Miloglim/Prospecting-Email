{
  "name": "prospecting-email",
  "version": "4.0.0",
  "description": "Milogin's Outreacher — 货代行业客户开发工具",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "set NODE_OPTIONS= && electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npx tsx scripts/check.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-router": "^1.170.0",
    "antd": "^5.22.0",
    "drizzle-orm": "^0.36.0",
    "electron-updater": "^6.0.0",
    "imapflow": "^1.6.5",
    "lucide-react": "^0.460.0",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.28.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.miloglim.prospecting-email",
    "productName": "Milogin's Prospector Next",
    "directories": {
      "output": "../dist-release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
